# ── Operating system ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.tmp

# ── Editors / IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version

# ── Node (the repository checks use Node, so a stray install is possible) ──
node_modules/

# ── Environments and secrets (never commit) ──────────────────────────
# *.pem and *.key stay ignored on purpose: the guides never ask you to version
# a private key, and a lab key that lands here by accident is worse than one
# you have to add with `git add -f`.
.env
.env.*
*.pem
*.key
*.token

# ── Lab artefacts and command output ─────────────────────────────────
*.log
logs/
out/
artifacts/
*.ovpn

# ── Script output (intermediate results) ─────────────────────────────
reports/
